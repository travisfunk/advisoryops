{
  "version": 1,
  "description": "Schema contract: every field the pipeline emits via _feed_entry (community_build.py) plus every field the dashboard renders. Enforced by tests/test_feed_contract.py. If you add a field to _feed_entry or to the dashboard JS, add it here first.",
  "last_updated": "2026-04-13",
  "fields": {
