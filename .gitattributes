# Default: keep LF in repo for all text files (platform-agnostic)
* text=auto eol=lf

# Windows scripts: keep CRLF for best PS/CMD behavior on Windows
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.gz  binary
*.7z  binary
*.ico binary
*.exe binary
*.dll binary

# Published copies/data are reproducible outputs; review authored source instead.
# GitHub keeps these available, but collapses them in pull-request diffs.
docs/index.html linguist-generated=true
docs/sbom.js linguist-generated=true
docs/sbom-ui.js linguist-generated=true
docs/sbom_advisories.json linguist-generated=true
configs/sbom_vendor_sources.json linguist-generated=true
